<mxfile host="cli" agent="manual" version="30.0.2">
  <diagram id="topology" name="测试环境拓扑">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="expert" value="评测专家终端&#10;(测试机构)" style="shape=mxgraph.networking.workstation;html=1;align=center;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="120" height="100" as="geometry" />
        </mxCell>

        <mxCell id="internet" value="公共互联网&#10;Internet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="110" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="relay_rd" value="RustDesk 中继" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="115" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="firewall" value="防火墙" style="shape=mxgraph.cisco.security.firewall;html=1;align=center;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="90" height="80" as="geometry" />
        </mxCell>

        <mxCell id="host" value="测试机&#10;BM-Server-Deb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="100" width="120" height="100" as="geometry" />
        </mxCell>

        <mxCell id="edge1" style="endArrow=classic;html=1;curved=1;strokeWidth=2;" edge="1" parent="1" source="expert" target="internet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge2" style="endArrow=classic;html=1;curved=1;strokeWidth=2;" edge="1" parent="1" source="internet" target="relay_rd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge3" style="endArrow=classic;html=1;curved=1;strokeWidth=2;" edge="1" parent="1" source="relay_rd" target="firewall">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge4" style="endArrow=classic;html=1;curved=1;strokeWidth=2;" edge="1" parent="1" source="firewall" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
